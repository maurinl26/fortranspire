# Dockerfile for the Fortran-to-JAX LangGraph Agents
FROM python:3.11-slim

# Install system dependencies (gfortran for compilation/testing)
RUN apt-get update && apt-get install -y \
    build-essential \
    gfortran \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip

# Install Loki-IFS
RUN git clone https://github.com/ecmwf-ifs/loki.git /opt/loki && \
    cd /opt/loki && pip install -e .

# Install the project with the JAX + GPU-pipeline extras + tests deps.
# Skip [mcp] in CI (the server isn't exercised in unit tests).
COPY pyproject.toml .
COPY fortranspire/ ./fortranspire/
RUN pip install --no-cache-dir -e ".[gpu,jax,tests]"

# Copy source
COPY . .

ENV PYTHONPATH=/app
