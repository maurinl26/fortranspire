# Copy to .env and fill in. Never commit the filled file.

# The public hostname whose A record points at this VPS. Caddy obtains a
# Let's Encrypt certificate for it automatically.
FORTRANSPIRE_DOMAIN=mcp.example.eu

# Bearer token the connector directory stores as a secret and sends on
# every call. Generate one: `openssl rand -hex 32`.
API_KEY=

# 256-bit secret that signs the audit log. `openssl rand -hex 32`.
FORTRANSPIRE_AUDIT_SECRET=

# Optional: raise/lower the inline-source size cap (bytes).
# FORTRANSPIRE_MAX_SOURCE_BYTES=1000000
